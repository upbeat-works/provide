{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climate-risk-dashboard.org/schemas/dashboard-chart.json",
  "title": "Dashboard chart list",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "type", "dimensions"],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string"
      },
      "type": {
        "enum": ["line", "bar", "scatter", "table"]
      },
      "dimensions": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
