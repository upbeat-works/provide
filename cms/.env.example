# Local development env for the vendored Strapi (cms/).
# Copy to cms/.env and fill in. Secrets below are LOCAL-ONLY — generate fresh,
# do not reuse production values.

HOST=0.0.0.0
PORT=1337

# App secrets — generate each with: openssl rand -base64 16
APP_KEYS=key1==,key2==
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me

# Database — shared Postgres, `strapi` schema (the API uses the `catalog` schema
# of the same database). See config/database.js.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=provide
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SCHEMA=strapi
DATABASE_SSL=false

# S3-compatible object storage (media uploads) — Cloudflare R2, or an in-cluster
# MinIO/Ceph. Intentionally UNSET locally, so the built-in local filesystem
# provider is used (see config/plugins.js). Set these only in environments that
# upload to an object store (production).
#
# S3_ENDPOINT is the S3 API root; the SDK appends /<bucket>/<key> itself.
# S3_PUBLIC_URL is the public read prefix and must INCLUDE the bucket — it is
# joined to the object key alone. For an object served at
# https://domain.com/storage/my-bucket/my-object that means:
#   S3_ENDPOINT=https://domain.com/storage
#   S3_BUCKET=my-bucket
#   S3_PUBLIC_URL=https://domain.com/storage/my-bucket
# S3_BUCKET=
# S3_ENDPOINT=http://minio.storage.svc.cluster.local:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://<public-media-domain>/<bucket>
# S3_REGION=us-east-1   # omit for R2 (defaults to 'auto')
