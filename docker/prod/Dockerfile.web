# Production image for the SvelteKit frontend (SSR via adapter-node).
# Build context: repository root.
# VITE_* values are baked into the client bundle at build time.

# ---- build ----
FROM registry.iiasa.ac.at/scse-library/climate-risk-dashboard-node:latest AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Browser-facing configuration.
ARG VITE_API_URL=/api
ARG VITE_CMS_URL=https://cms.climate-risk-dashboard.org/
# SSR-facing configuration for the Kubernetes services.
ARG VITE_API_URL_INTERNAL=http://api-service:8080/api
ARG VITE_CMS_URL_INTERNAL=http://cms-service:1337
# Legacy Climate Analytics API and content locale.
ARG VITE_DATA_API_URL=https://provide-api.iiasa.ac.at/api
ARG VITE_STRAPI_LOCALE=en-EU
# App and integrations.
ARG VITE_SCREENSHOT_URL=https://climate-risk-dashboard.iiasa.ac.at/api/puppeteer
ARG VITE_APP_URL=https://climate-risk-dashboard.org/
ARG VITE_IS_PUBLIC_VERSION=true
ARG VITE_MAPBOX_STYLE_LIGHT=mapbox://styles/iiasaict/cm4r5yz0x00bs01sagjuy8ggv
ARG VITE_MAPBOX_STYLE_SATELLITE=mapbox://styles/iiasaict/cm4r5zq9c00av01qt48262kxi
ARG VITE_MAPBOX_STYLE_GLOBE=mapbox://styles/iiasaict/cm4r60i0500ae01r12lze15vf
ARG VITE_MAPBOX_STYLE_STUDY_LOCATIONS=mapbox://styles/iiasaict/cm4r6l3gn001801s8fqq34mis
ARG VITE_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiaWlhc2FpY3QiLCJhIjoiY200cjFlYnZsMDA2dzJtc2NqMnZ4OHJkcyJ9.1phMz-gQqfAPz7WkzFXBfw

# Surface the args to Vite.
ENV VITE_API_URL=$VITE_API_URL \
    VITE_CMS_URL=$VITE_CMS_URL \
    VITE_API_URL_INTERNAL=$VITE_API_URL_INTERNAL \
    VITE_CMS_URL_INTERNAL=$VITE_CMS_URL_INTERNAL \
    VITE_DATA_API_URL=$VITE_DATA_API_URL \
    VITE_STRAPI_LOCALE=$VITE_STRAPI_LOCALE \
    VITE_APP_URL=$VITE_APP_URL \
    VITE_SCREENSHOT_URL=$VITE_SCREENSHOT_URL \
    VITE_IS_PUBLIC_VERSION=$VITE_IS_PUBLIC_VERSION \
    VITE_MAPBOX_ACCESS_TOKEN=$VITE_MAPBOX_ACCESS_TOKEN \
    VITE_MAPBOX_STYLE_LIGHT=$VITE_MAPBOX_STYLE_LIGHT \
    VITE_MAPBOX_STYLE_SATELLITE=$VITE_MAPBOX_STYLE_SATELLITE \
    VITE_MAPBOX_STYLE_GLOBE=$VITE_MAPBOX_STYLE_GLOBE \
    VITE_MAPBOX_STYLE_STUDY_LOCATIONS=$VITE_MAPBOX_STYLE_STUDY_LOCATIONS
RUN npm run build

# ---- runtime ----
FROM registry.iiasa.ac.at/scse-library/climate-risk-dashboard-node:latest AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV PROTOCOL_HEADER=x-forwarded-proto
ENV HOST_HEADER=x-forwarded-host

# adapter-node externalizes runtime dependencies.
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/build ./build

EXPOSE 3000
CMD ["node", "build"]
