# Production image for the Hono/Bun API (server.ts).
# Build context: repository root.

FROM registry.iiasa.ac.at/scse-library/bun:latest AS base
WORKDIR /app

FROM registry.iiasa.ac.at/scse-library/climate-risk-dashboard-node:latest AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

FROM base AS runtime
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY server.ts ./
COPY api ./api

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080
CMD ["bun", "run", "server.ts"]
