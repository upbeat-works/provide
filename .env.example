# ─── APIs ────────────────────────────────────────────────────────────────────

# Catalog API — the Hono adapter in this repo's api/ directory (Postgres + ixmp4).
# Serves the convention-driven catalogue surface, including impact map grids and downloads.
# Runs on the Bun/Node runtime (`npm run dev:api`, server.ts) → http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# Legacy Climate Analytics Data API (provide-api.iiasa.ac.at).
# Still used for: /geo-shape, /avoiding-impacts, and /avoiding-reference.
VITE_DATA_API_URL=https://provide-api.iiasa.ac.at/api

# Strapi CMS for editorial content (indicator/scenario descriptions, stories).
# Vendored in cms/; run locally with `npm run dev:strapi` (serves on :1337).
VITE_CMS_URL=http://localhost:1337
VITE_STRAPI_LOCALE=en

# ─── API server runtime (server.ts / Bun) ────────────────────────────────────
# Auto-loaded by `bun run server.ts`. The API's tables live in the `catalog`
# schema of a shared Postgres (Strapi uses the `strapi` schema of the same DB).
#
# DB connection — discrete fields (user & password as separate secrets).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=provide
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SCHEMA=catalog
PORT=8080

# GeoServer base URL, including /geoserver. Leave empty when maps are not deployed.
GEOSERVER_URL=
GEOSERVER_WORKSPACE=provide
# Optional read-only WCS credentials. Set both or leave both empty.
GEOSERVER_USERNAME=
GEOSERVER_PASSWORD=

# ixmp4 platform credentials (the external data source).
IXMP4_USERNAME=your-username
IXMP4_PASSWORD=your-password

# ─── App ─────────────────────────────────────────────────────────────────────

# Public base URL of the app, used to build embed/share links.
VITE_APP_URL=http://localhost:5173

# Screenshot service used to render chart images for downloads/embeds.
VITE_SCREENSHOT_URL=

# Set to "true" for the public-facing build (toggles internal-only UI).
VITE_IS_PUBLIC_VERSION=false

# ─── Mapbox (maps + geo-shape views) ─────────────────────────────────────────

VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token
VITE_MAPBOX_STYLE_LIGHT=mapbox://styles/mapbox/light-v11
VITE_MAPBOX_STYLE_SATELLITE=mapbox://styles/mapbox/satellite-v9
VITE_MAPBOX_STYLE_STUDY_LOCATIONS=mapbox://styles/mapbox/light-v11
